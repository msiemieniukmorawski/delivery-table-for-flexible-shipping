<?xml version="1.0"?>
<ruleset name="Delivery Table for Flexible Shipping">
	<description>Coding standards for the plugin.</description>

	<file>.</file>

	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<rule ref="WordPress-Extra">
		<!--
			The plugin follows PSR-12 file and naming conventions rather than the
			WordPress ones: PSR-4 class files, camelCase methods, short array syntax
			and four-space indentation. Those sniffs are turned off deliberately;
			everything about security, escaping, i18n and prefixing stays on.
		-->
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="WordPress.NamingConventions.ValidVariableName"/>
		<exclude name="WordPress.NamingConventions.ValidFunctionName"/>
		<exclude name="WordPress.Arrays.ArrayDeclarationSpacing"/>
		<exclude name="WordPress.Arrays.ArrayIndentation"/>
		<exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<exclude name="Squiz.Commenting.FileComment"/>

		<!--
			Spacing inside brackets and parentheses. WordPress writes `foo( $bar )`
			and `if ( $x )`; PSR-12 writes `foo($bar)` and `if ($x)`. Same
			disagreement, one decision, so the whole family goes rather than the
			handful of error codes that used to be listed here.
		-->
		<exclude name="PEAR.Functions.FunctionCallSignature"/>
		<exclude name="Squiz.Functions.FunctionDeclarationArgumentSpacing"/>
		<exclude name="Squiz.Functions.MultiLineFunctionDeclaration"/>
		<exclude name="WordPress.WhiteSpace.ControlStructureSpacing"/>
		<exclude name="WordPress.WhiteSpace.CastStructureSpacing"/>
		<exclude name="WordPress.WhiteSpace.OperatorSpacing"/>
		<exclude name="Generic.WhiteSpace.ArbitraryParenthesesSpacing"/>
		<exclude name="WordPress.Arrays.ArrayKeySpacingRestrictions"/>
		<exclude name="NormalizedArrays.Arrays.ArrayBraceSpacing"/>
		<exclude name="NormalizedArrays.Arrays.CommaAfterLast"/>

		<!-- PSR-12 opens a class or function brace on the next line. -->
		<exclude name="Generic.Classes.OpeningBraceSameLine"/>
		<exclude name="Generic.Functions.OpeningFunctionBraceKernighanRitchie"/>

		<!-- Aligning `=` and `=>` into columns; the code reads fine without it. -->
		<exclude name="WordPress.Arrays.MultipleStatementAlignment"/>
		<exclude name="Generic.Formatting.MultipleStatementAlignment"/>

		<!--
			Yoda conditions guard against `=` typed for `==`. Every comparison here
			is strict and every file declares strict types, so the guard buys
			nothing and costs readability.
		-->
		<exclude name="WordPress.PHP.YodaConditions"/>

		<!-- `?:` is deliberate: PHP 8.1 is the floor, and the elvis reads well. -->
		<exclude name="Universal.Operators.DisallowShortTernary"/>

		<!--
			`$echo` and `$class` as parameter names. WordPress core itself uses
			`$echo` throughout, and `$class` is what a PSR-4 autoloader receives.
		-->
		<exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames"/>
	</rule>

	<!--
		Storefront views are required from inside Template::render(), so the
		variables they use live in a method scope, not the global one. The sniff
		cannot see that, but it must keep working everywhere else.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>/templates/*</exclude-pattern>
	</rule>

	<!--
		`$this` inside an enum method is valid PHP 8.1; the sniff does not model
		enums and reads TaxDisplay::apply() as a plain function.
	-->
	<rule ref="PHPCompatibility.Variables.ForbiddenThisUseContexts">
		<exclude-pattern>/includes/Shipping/Tax/TaxDisplay.php</exclude-pattern>
	</rule>

	<rule ref="Generic.WhiteSpace.ScopeIndent">
		<properties>
			<property name="indent" value="4"/>
			<property name="tabIndent" value="false"/>
		</properties>
	</rule>

	<!-- Every global symbol must carry the plugin prefix. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="dtfs"/>
				<element value="MSM\DeliveryTable"/>
			</property>
		</properties>
	</rule>

	<!-- The text domain must match the plugin slug. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="delivery-table-for-flexible-shipping"/>
			</property>
		</properties>
	</rule>

	<!-- Minimum supported versions. -->
	<config name="minimum_wp_version" value="6.2"/>
	<config name="testVersion" value="8.1-"/>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
